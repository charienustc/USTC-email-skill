{
  "name": "@local/ustc-mail",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Read-only USTC mailbox tools (mail.ustc.edu.cn) for the DeepSeek Harness, with a sidebar panel.",
  "icon": "./icon.svg",
  "meta": {
    "title": "科大邮箱",
    "description": "只读访问中国科学技术大学邮箱：侧边栏面板可浏览与搜索邮件，同时提供 ustc_mail_* 工具。"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "bin/credential-store.ps1",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
