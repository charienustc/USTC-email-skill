# Never commit a mailbox password.
# The tool keeps secrets in the OS keychain; the file below is only the fallback.
ustc-mail-credentials*.json
.ustc-mail-credentials.json
*.credentials.json
*.dpapi

# Private keys
*.pem
*.key
id_rsa*
id_ed25519*

# Where `attach` writes by default. Downloading somebody's mail into the
# repository is one keystroke away, so the directory is ignored outright.
ustc-mail-attachments/

# Node
node_modules/

# Editors and operating systems
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.log
